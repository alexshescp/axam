# Maintainer: Aleksandr Shaman <axam@codcl.com>
# Axam Studio — build from source
pkgname=axam
pkgver=1.1.0
pkgrel=1
pkgdesc='Axam Studio — modeless terminal text editor'
arch=('x86_64' 'aarch64')
url='https://github.com/alexshescp/axam'
license=('GPL-3.0-or-later')
makedepends=('go')
conflicts=('axam-bin')
provides=('axam')
options=('!strip')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/alexshescp/axam/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('81cbdbf16e0ae620512548c38126b6584455f4ada1355c382b5d73fa1b83ebdf')

build() {
  cd "${pkgname}-${pkgver}"
  export CGO_ENABLED=0
  export GOFLAGS='-trimpath -mod=readonly -modcacherw'
  go build -ldflags "-s -w -X main.version=${pkgver}" -o axam ./cmd/axam
}

check() {
  cd "${pkgname}-${pkgver}"
  go test ./...
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 axam "${pkgdir}/usr/bin/axam"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
